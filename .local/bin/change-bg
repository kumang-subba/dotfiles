#!/bin/bash

wallDIR="$HOME/Pictures/Wallpapers"

focused_monitor=$(hyprctl monitors | awk '/^Monitor/{name=$2} /focused: yes/{print name}')
unfocused_monitor=$(hyprctl monitors | awk '/^Monitor/{name=$2} /focused: no/{print name}')

PICS=($(find ${wallDIR} -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" \)))
RANDOMPIC=${PICS[$RANDOM % ${#PICS[@]}]}

typeoptions=("left" "right" "top" "bottom" "wipe" "wave" "grow" "center" "any" "outer")
# Transition config
FPS=144
TYPE=${typeoptions[$((RANDOM % ${#typeoptions[@]}))]}
DURATION=1.5
BEZIER=".25,.1,.25,1"
SWWW_PARAMS="--transition-fps $FPS --transition-type $TYPE --transition-duration $DURATION --transition-bezier $BEZIER"

awww img -o $focused_monitor ${RANDOMPIC} $SWWW_PARAMS

RANDOMPIC=${PICS[$RANDOM % ${#PICS[@]}]}

TYPE=${typeoptions[$((RANDOM % ${#typeoptions[@]}))]}
DURATION=1.5
BEZIER=".25,.1,.25,1"
SWWW_PARAMS="--transition-fps $FPS --transition-type $TYPE --transition-duration $DURATION --transition-bezier $BEZIER"
awww img -o $unfocused_monitor ${RANDOMPIC} $SWWW_PARAMS
